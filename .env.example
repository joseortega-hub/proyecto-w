# Copia este archivo como .env y rellena los valores.
# .env NUNCA se sube a Git (está en .gitignore); este .env.example sí, sin secretos.

# --- Proveedores de IA ---
# Quién toma las decisiones (siguiente pregunta, perfil de ánimo, ¿encaja este elemento?): jev | gemini
DECISION_PROVIDER=gemini

# Jev (TypeSafe AI) - https://console.typesafe.ai  (requiere crédito en Billing)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Gemini (Google AI Studio, plan gratuito) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo de las decisiones y modelo del texto: van separados para que cada uno tenga
# su propio cupo del plan gratuito (15 peticiones/min por modelo)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Respaldo, en orden, si el modelo principal está saturado (503), sin cuota o no responde
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
# Modelo de embeddings (Fase 2; 768 dimensiones)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Catálogo de música ---
# Jamendo (gratuito) - https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# --- Base de datos (Docker en local) ---
DATABASE_URL=postgresql://proyecto:proyecto@localhost:5434/proyecto

# --- Servidor ---
API_PORT=3001
WEB_URL=http://localhost:5173
