# Copia este archivo como .env y rellena los valores.
# .env NUNCA se sube a Git (está en .gitignore); este .env.example sí, sin secretos.

# --- Proveedores de IA ---
# Perfil de ánimo (score) y % de encaje (noul): jev | gemini (con jev, Gemini queda de respaldo)
DECISION_PROVIDER=gemini
# Siguiente pregunta de la entrevista (choice): cadena de respaldo, responde el primero disponible.
# Admite groq, laya, gemini y jev. En producción, sin Ollaya: groq,gemini
DECISION_CHAIN=groq,laya,gemini
# Texto (explicaciones y redacción en vivo de preguntas sin banco): groq y gemini
TEXT_CHAIN=groq,gemini

# Laya en local con Ollaya (compatible con la API de Jev; sin clave).
# docker compose --profile laya up -d  y luego, una vez:  docker exec ollaya ollaya pull laya:multilingual
LAYA_BASE_URL=http://127.0.0.1:11435
LAYA_MODEL=laya:multilingual
LAYA_TIMEOUT_MS=3000
# En producción, Laya vive en un Space de Hugging Face (deploy/laya-space): pon su URL
# (https://<usuario>-<space>.hf.space) y la clave que guardaste como secreto OLLAYA_API_KEY.
# LAYA_API_KEY=
# LAYA_WARMUP_TIMEOUT_MS=180000

# Caché de respuestas de IA en la BD (decisiones 7 días, texto 24 h). AI_CACHE=off la apaga.
AI_CACHE=on
# AI_CACHE_DECISION_TTL_H=168
# AI_CACHE_TEXT_TTL_H=24

# Groq (plan gratuito, sin tarjeta) - https://console.groq.com/keys
# Cada modelo tiene su cupo (~30 peticiones y ~8K tokens por minuto): decisiones y texto usan modelos distintos
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
# Respaldo adicional dentro de Groq (opcional; el último recurso es el modelo de la otra tarea)
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# Jev (TypeSafe AI) - https://console.typesafe.ai  (requiere crédito en Billing)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Gemini (Google AI Studio, plan gratuito) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo de las decisiones y modelo del texto: van separados para que cada uno tenga
# su propio cupo del plan gratuito (15 peticiones/min por modelo)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Respaldo, en orden, si el modelo principal está saturado (503), sin cuota o no responde
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash-lite,gemini-2.5-flash
# Modelo de embeddings (Fase 2; 768 dimensiones)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Catálogo de música ---
# Jamendo (gratuito) - https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# --- Catálogo de videojuegos ---
# RAWG (clave gratuita; uso no comercial con atribución y enlace a RAWG) - https://rawg.io/apidocs
RAWG_API_KEY=
# Steam Web API (clave gratuita; perfil público de la persona; sin afiliación con Valve) - https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# --- Catálogo de películas ---
# TMDB (clave gratuita de desarrollador; atribución obligatoria) - https://www.themoviedb.org/settings/api
# Vale la "API Key" (v3) o el "API Read Access Token" (v4)
TMDB_API_KEY=

# --- Catálogo de libros ---
# Open Library no necesita clave. Con un User-Agent identificado el límite sube de 1 a 3 peticiones/s:
# pon aquí un correo de contacto si quieres que vaya en el User-Agent (opcional)
OPEN_LIBRARY_CONTACT=

# --- Conectar YouTube (OAuth de Google + YouTube Data API v3) ---
# Cliente OAuth de tipo "Aplicación web" en Google Cloud, con la YouTube Data API v3 habilitada,
# el permiso https://www.googleapis.com/auth/youtube y estas URI de redirección:
#   http://localhost:5173/api/youtube/callback  y  https://<tu-web>/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: por defecto, WEB_URL + /api/youtube/callback (llega a la API por el proxy /api de la web)
GOOGLE_REDIRECT_URI=
# Clave para cifrar los tokens de Google en la BD (cualquier texto largo y aleatorio).
# Si se deja vacía, se deriva de GOOGLE_CLIENT_SECRET.
TOKEN_ENCRYPTION_KEY=
# Canciones como máximo por importación (cada una gasta un embedding del cupo diario de Gemini)
YOUTUBE_IMPORT_LIMIT=400

# --- Base de datos (Docker en local) ---
DATABASE_URL=postgresql://proyecto:proyecto@localhost:5434/proyecto
# Producción (Neon), solo para pnpm sync-embeddings desde local. La API desplegada usa DATABASE_URL.
PROD_DATABASE_URL=

# --- Buzón de comentarios ---
# Opcional: clave para leer y marcar el buzón por HTTP (cabecera x-feedback-key). Sin ella,
# el buzón solo se lee con `pnpm feedback [--prod]`, que va directo a la BD.
FEEDBACK_ADMIN_KEY=

# --- Servidor ---
API_PORT=3001
WEB_URL=http://localhost:5173

# --- Contexto automático (hora y tiempo con Open-Meteo, sin clave) ---
# Zona horaria y posición por defecto si el navegador no manda las suyas
CONTEXT_TIME_ZONE=Europe/Madrid
CONTEXT_LATITUDE=40.4168
CONTEXT_LONGITUDE=-3.7038
# Contacto (correo o URL) que MusicBrainz pide en el User-Agent; sin él se usa la URL del repositorio.
MUSICBRAINZ_CONTACT=

# --- Fuentes extra de refuerzo (confirman y amplían con datos reales; opcionales) ---
# Last.fm (clave gratuita): artistas similares y mejores de una etiqueta - https://www.last.fm/api/account/create
LASTFM_API_KEY=
# YouTube Data API v3 (clave de API gratuita, solo en tu PC): canciones de los canales y visitas del Modo Perreo
# (pnpm perreo:import y pnpm perreo:pulse). No hace falta en Render.
YOUTUBE_API_KEY=
# Google Books (clave gratuita): ediciones en español y sinopsis - https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=
