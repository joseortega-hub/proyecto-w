{
  "name": "sintonia",
  "private": true,
  "description": "Sintonía: un catálogo que te entiende (Proyecto X)",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sintonia/api --filter @sintonia/web dev",
    "build": "pnpm -r build",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @sintonia/api db:migrate",
    "seed": "pnpm --filter @sintonia/api seed",
    "embed": "pnpm --filter @sintonia/api embed",
    "classify": "pnpm --filter @sintonia/api classify",
    "questions": "pnpm --filter @sintonia/api questions",
    "sync-embeddings": "pnpm --filter @sintonia/api sync-embeddings",
    "storybook": "pnpm --filter @sintonia/web storybook",
    "tokens": "pnpm --filter @sintonia/tokens build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "eval": "pnpm --filter @sintonia/api eval",
    "facets": "pnpm --filter @sintonia/api facets",
    "feedback": "pnpm --filter @sintonia/api feedback",
    "perreo:import": "pnpm --filter @sintonia/api perreo:import",
    "perreo:load": "pnpm --filter @sintonia/api perreo:load",
    "perreo:instagram": "pnpm --filter @sintonia/api perreo:instagram",
    "perreo:instagram:import": "pnpm --filter @sintonia/api perreo:instagram:import",
    "perreo:pulse": "pnpm --filter @sintonia/api perreo:pulse",
    "perreo:favorites": "pnpm --filter @sintonia/api perreo:favorites"
  }
}
