  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Bricolage Grotesque",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ]
      },
      "body": {
        "$value": [
          "Atkinson Hyperlegible",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "Cascadia Mono",
          "ui-monospace",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "bold": {
        "$value": 700
      },
      "black": {
        "$value": 800
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "base": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 20,
          "unit": "px"
